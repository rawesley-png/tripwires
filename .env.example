# Copy to .env and fill in. Lines starting with # are ignored.

# Required: rates, credit, oil, VIX, CPI, unemployment, Fed target, yen (free key, instant)
FRED_API_KEY=

# Recommended: soft signals via Claude + web search (~$0.20-0.50 per run). Without it, those tiles say "not checked".
ANTHROPIC_API_KEY=

# SEC asks for a contact in the request header
EDGAR_USER_AGENT=Your Name yourname@example.com

# If you skip the Claude key, set the S&P 500 forward P/E by hand so the valuation tile still works
FORWARD_PE_FALLBACK=

# Where the app is hosted (put in alerts). Leave blank if you open the file locally.
SITE_URL=

# Email alerts (Gmail app password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=
ALERT_EMAIL=yourname@gmail.com

# Phone push (optional): https://pushover.net
PUSHOVER_USER=
PUSHOVER_TOKEN=
